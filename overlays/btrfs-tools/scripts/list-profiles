#!/bin/sh
# list-profiles - list the bootable PROFILES at the btrfs top level: the profile roots
# (@Desktop, @Minimal, ...) and @<profile>_old_* leftovers from create-profile. KIND tags each
# (profile/old); PARENT is what it was snapshotted from (via Parent UUID); ORIGIN is the _stock
# base it was built from (origin_stock_name from /etc/profile_origin, '-' if none). Names are
# top-level paths (what create-profile/rename-profile/delete-profile take). The booted profile is
# marked <- booted. LAST USED is when the profile last RAN: 'now' for the running one, 'never' if never.
# For _stock golden bases and restore points, see list-snapshots.
# Works via a subvolid=5 (top-level) mount.
#
# Example:
#   list-profiles   # @SourceProfile / @DestinationProfile roots, _stock bases and _old leftovers
set -eu
[ -r /usr/lib/flipper-btrfs.sh ] || { echo "Error: /usr/lib/flipper-btrfs.sh not found" >&2; exit 1; }
. /usr/lib/flipper-btrfs.sh

usage() {
    cat <<EOF
Usage: list-profiles [-d|--device DEV]
$HELP_DEVICE
  List bootable profiles at the btrfs top level: profile roots and @<profile>_old_*
  leftovers. For _stock golden bases and restore points, see list-snapshots.
EOF
}

while [ $# -gt 0 ]; do
    case "$1" in
        -d|--device) shift; need_device_arg "$#"; ROOTDEV=$1 ;;
        --device=*)  ROOTDEV=${1#*=} ;;
        -h|--help)   usage; exit 0 ;;
        -?*)         echo "Error: unknown option: $1" >&2; usage >&2; exit 1 ;;
        *)           echo "Error: unexpected argument: $1 (this tool takes no arguments)" >&2; usage >&2; exit 1 ;;
    esac
    shift
done

need_root
need_btrfs

map=$(mktemp)
rows=$(mktemp)
TOP_TMPFILES="$map $rows"
mount_top
build_uuid_map "$TOP" "$map"

cur_id=$(target_running_id); cur_subvol=$(target_running_subvol)
if [ -n "$cur_id" ]; then
    echo "Currently booted profile: ${cur_subvol:-?} (id $cur_id)"
else
    echo "Listing $ROOTDEV, which is not the filesystem you booted from"
fi
echo

# Newest of systemd's random-seed (written at every boot and clean shutdown) and timesyncd's clock
# (written while the profile runs). Both are inherited from whatever the profile was made from, so
# only a stamp newer than the profile's own creation counts; anything older reads 'never'.
# $1 = fs path  $2 = creation epoch -> "YYYY-MM-DD HH:MM:SS" | never
last_used() {
    _lu=""
    for _w in var/lib/systemd/random-seed var/lib/systemd/timesync/clock; do
        [ -f "$1/$_w" ] || continue
        _t=$(stat -c '%Y %y' "$1/$_w" 2>/dev/null) || continue
        [ -n "${2:-}" ] && [ "${_t%% *}" -le "$2" ] && continue
        case "$_lu" in
            "") _lu=$_t ;;
            *)  [ "${_t%% *}" -gt "${_lu%% *}" ] && _lu=$_t ;;
        esac
    done
    case "$_lu" in
        "") printf 'never' ;;
        *)  printf '%s' "$(printf '%s' "${_lu#* }" | cut -c1-19)" ;;
    esac
}

# $1=display name  $2=fs path
emit() {
    info=$(btrfs subvolume show "$2" 2>/dev/null) || return 0
    id=$(get "$info" "Subvolume ID")
    otime=$(get "$info" "Creation time")
    flags=$(get "$info" "Flags"); case "$flags" in *readonly*) flags=ro ;; *) flags=rw ;; esac
    parent=$(parent_of "$map" "$(get "$info" "Parent UUID")")
    case "$1" in
        # _old_<ts> leftovers from create-profile; anchored on the stamp so a user-chosen
        # name that merely contains "_old_" stays a profile ('.old_' is the legacy spelling)
        *_old_[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]_*|*.old_*) kind=old ;;
        *)       kind=profile ;;
    esac
    mark=""; is_running_id "$id" "$cur_id" && mark="<- booted"
    # the _stock base this profile was built from, as recorded at build time; the exact name
    # (with build id) that Factory Reset restores from and that identifies its origin
    origin=$(sed -n 's/^origin_stock_name=//p' "$2/etc/profile_origin" 2>/dev/null | head -n1)
    if [ -n "$origin" ]; then
        # append the stock's subvolume id when it is on disk, like the PARENT column
        if [ -e "$TOP/@stock-snapshots/$origin" ]; then
            _oid=$(subvol_id "$TOP/@stock-snapshots/$origin" 2>/dev/null)
            [ -n "$_oid" ] && origin="$origin ($_oid)"
        fi
    else
        origin="-"
    fi
    # convert while the "+0000" btrfs prints is still there: date -d without a zone assumes the
    # reader's, which shifts the epoch whenever that differs from the zone the profile was made in
    oepoch=$(date -d "$otime" +%s 2>/dev/null || echo "")
    # The column shows the time without the zone
    otime=${otime% +*}
    # the profile we are running from writes its state at boot and then only now and then, so a
    # timestamp here would read as stale for the one profile that is definitely in use
    if [ -n "$mark" ]; then lu=now; else lu=$(last_used "$2" "$oepoch"); fi
    printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' "$1" "$mark" "$kind" "${id:-?}" "${otime:-?}" "$lu" "$flags" "$parent" "$origin"
}

printf 'NAME\t\tKIND\tID\tCREATED\tLAST USED\tRO\tPARENT\tORIGIN\n' > "$rows"
# top-level profile roots + @_old_* leftovers; skip shared/reserved subvols (@snapshots,
# @stock-snapshots, ...) so stocks (now nested under @stock-snapshots) are not listed here
# One job per profile, because each one costs a handful of processes (two `btrfs
# subvolume show`s, a sed, a date, two stats) and they share nothing but the mount and
# the uuid map, both read-only by here. Eleven profiles done in turn is a hundred-odd
# spawns waited for one at a time; this board has eight cores to do them on.
#
# Each job writes one file named by its position, so the table's order is the glob's order
# however the jobs finish, and no two jobs append to the same file. Concurrency is capped
# at the core count: the work is short and the cap only keeps a filesystem full of
# profiles from starting a hundred at once.
jobs_dir=$(mktemp -d "${TMPDIR:-/tmp}/list-profiles.XXXXXX")
_max=$(nproc 2>/dev/null || echo 4)
_running=0
_i=0
for d in "$TOP"/@*; do
    [ -e "$d" ] || continue
    n=${d##*/}
    is_reserved_subvol "$n" && continue
    btrfs subvolume show "$d" >/dev/null 2>&1 || continue
    _i=$((_i + 1))
    emit "$n" "$d" > "$jobs_dir/$(printf '%04d' "$_i")" &
    _running=$((_running + 1))
    if [ "$_running" -ge "$_max" ]; then
        wait
        _running=0
    fi
done
wait
cat "$jobs_dir"/* >> "$rows" 2>/dev/null || true
rm -rf "$jobs_dir"
align_table "$rows"
