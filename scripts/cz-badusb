#!/usr/bin/env python3
"""
cz-badusb — DuckyScript 1.0 / Flipper BadUSB HID Injector & TUI Arsenal for CardputerZero.

Features:
  - Drives `/dev/hidg0` directly with USB Boot Keyboard 8-byte HID reports.
  - Auto-enables `cz-flipper-gadget combo` (USB Ethernet 10.55.0.1 + HID Keyboard)
    when `/dev/hidg0` is absent so SSH and `:8899` Web Remote stay alive during injection.
  - `--menu` provides a 45x10 LCD-friendly interactive terminal UI for `cz-term80`
    to fire BadUSB payloads, mount bootable `.iso`/`.img` files, create FAT32 loot
    images, or toggle MTP / Combo / Host modes.
"""

from __future__ import annotations

import os
import subprocess
import sys
import time
from pathlib import Path

HID_DEV = Path("/dev/hidg0")
GADGET_CTL = "/usr/local/bin/cz-flipper-gadget"
PAYLOAD_DIRS = [
    Path("/home/kali/payloads"),
    Path("/usr/share/czctl/payloads"),
    Path("/usr/share/flipctl/payloads"),
]
ISO_DIRS = [Path("/home/kali/isos"), Path("/root/isos")]

MOD_BITS = {
    "CTRL": 0x01,
    "CONTROL": 0x01,
    "RCTRL": 0x10,
    "SHIFT": 0x02,
    "RSHIFT": 0x20,
    "ALT": 0x04,
    "RALT": 0x40,
    "GUI": 0x08,
    "WINDOWS": 0x08,
    "COMMAND": 0x08,
    "META": 0x08,
}

SPECIAL_KEYS = {
    "ENTER": 0x28,
    "RETURN": 0x28,
    "ESC": 0x29,
    "ESCAPE": 0x29,
    "BACKSPACE": 0x2A,
    "BKSP": 0x2A,
    "TAB": 0x2B,
    "SPACE": 0x2C,
    "CAPSLOCK": 0x39,
    "PRINTSCREEN": 0x46,
    "SCROLLLOCK": 0x47,
    "PAUSE": 0x48,
    "INSERT": 0x49,
    "HOME": 0x4A,
    "PAGEUP": 0x4B,
    "DELETE": 0x4C,
    "DEL": 0x4C,
    "END": 0x4D,
    "PAGEDOWN": 0x4E,
    "RIGHT": 0x4F,
    "RIGHTARROW": 0x4F,
    "LEFT": 0x50,
    "LEFTARROW": 0x50,
    "DOWN": 0x51,
    "DOWNARROW": 0x51,
    "UP": 0x52,
    "UPARROW": 0x52,
    "APP": 0x65,
    "MENU": 0x65,
}
for _i in range(1, 13):
    SPECIAL_KEYS[f"F{_i}"] = 0x39 + _i

ASCII_MAP: dict[str, tuple[int, int]] = {
    " ": (0x00, 0x2C),
    "\t": (0x00, 0x2B),
    "\n": (0x00, 0x28),
    "-": (0x00, 0x2D),
    "_": (0x02, 0x2D),
    "=": (0x00, 0x2E),
    "+": (0x02, 0x2E),
    "[": (0x00, 0x2F),
    "{": (0x02, 0x2F),
    "]": (0x00, 0x30),
    "}": (0x02, 0x30),
    "\\": (0x00, 0x31),
    "|": (0x02, 0x31),
    ";": (0x00, 0x33),
    ":": (0x02, 0x33),
    "'": (0x00, 0x34),
    '"': (0x02, 0x34),
    "`": (0x00, 0x35),
    "~": (0x02, 0x35),
    ",": (0x00, 0x36),
    "<": (0x02, 0x36),
    ".": (0x00, 0x37),
    ">": (0x02, 0x37),
    "/": (0x00, 0x38),
    "?": (0x02, 0x38),
}
for _idx, _ch in enumerate("abcdefghijklmnopqrstuvwxyz"):
    ASCII_MAP[_ch] = (0x00, 0x04 + _idx)
    ASCII_MAP[_ch.upper()] = (0x02, 0x04 + _idx)
_DIGITS = "1234567890"
_SHIFTED_DIGITS = "!@#$%^&*()"
for _idx in range(10):
    ASCII_MAP[_DIGITS[_idx]] = (0x00, 0x1E + _idx)
    ASCII_MAP[_SHIFTED_DIGITS[_idx]] = (0x02, 0x1E + _idx)


def sudo_cmd(args: list[str]) -> list[str]:
    return args if os.geteuid() == 0 else ["sudo", "-n", *args]


def ensure_hid_device(dry_run: bool = False) -> None:
    if dry_run or HID_DEV.exists():
        return
    print("[*] /dev/hidg0 not active; enabling composite Net+HID (combo) mode...", flush=True)
    res = subprocess.run(sudo_cmd([GADGET_CTL, "combo"]), check=False)
    if res.returncode != 0:
        raise RuntimeError("Failed to enable USB combo gadget mode")
    for _ in range(25):
        if HID_DEV.exists():
            print("[*] Waiting 1.2s for target USB HID enumeration...", flush=True)
            time.sleep(1.2)
            return
        time.sleep(0.1)
    raise RuntimeError("/dev/hidg0 did not appear after enabling combo gadget")


class HidWriter:
    def __init__(self, dry_run: bool = False) -> None:
        self.dry_run = dry_run
        self.fd: int | None = None
        if not dry_run:
            if os.geteuid() != 0 and not os.access(HID_DEV, os.W_OK):
                subprocess.run(sudo_cmd(["chmod", "666", str(HID_DEV)]), check=False)
            self.fd = os.open(str(HID_DEV), os.O_RDWR)

    def close(self) -> None:
        if self.fd is not None:
            try:
                os.write(self.fd, b"\x00" * 8)
            except OSError:
                pass
            os.close(self.fd)
            self.fd = None

    def tap(self, mod: int, keycode: int, hold_s: float = 0.012) -> None:
        if self.dry_run:
            return
        assert self.fd is not None
        os.write(self.fd, bytes([mod, 0, keycode, 0, 0, 0, 0, 0]))
        time.sleep(hold_s)
        os.write(self.fd, b"\x00" * 8)
        time.sleep(0.008)

    def type_string(self, text: str, char_delay_ms: int = 8) -> None:
        for ch in text:
            pair = ASCII_MAP.get(ch)
            if pair is None:
                continue
            self.tap(pair[0], pair[1])
            if char_delay_ms > 0:
                time.sleep(char_delay_ms / 1000.0)


def parse_combo(tokens: list[str]) -> tuple[int, int] | None:
    mod = 0
    key = 0
    for tok in tokens:
        up = tok.upper()
        if up in MOD_BITS:
            mod |= MOD_BITS[up]
        elif up in SPECIAL_KEYS:
            key = SPECIAL_KEYS[up]
        elif len(tok) == 1 and tok.lower() in ASCII_MAP:
            key = ASCII_MAP[tok.lower()][1]
        else:
            return None
    return (mod, key)


def run_ducky(script_path: Path, dry_run: bool = False) -> int:
    lines = script_path.read_text(encoding="utf-8", errors="replace").splitlines()
    ensure_hid_device(dry_run=dry_run)
    hid = HidWriter(dry_run=dry_run)
    default_delay_ms = 0
    prev_action: str | None = None

    def exec_line(raw: str, lineno: int) -> None:
        nonlocal default_delay_ms
        stripped = raw.strip()
        if not stripped or stripped.upper().startswith(("REM ", "REM\t")) or stripped.upper() == "REM":
            return
        if stripped.startswith("#"):
            return

        parts = stripped.split(" ", 1)
        cmd = parts[0].upper()
        rest = parts[1] if len(parts) > 1 else ""

        if cmd in ("DEFAULT_DELAY", "DEFAULTDELAY"):
            default_delay_ms = max(0, int(rest.strip() or "0"))
            return
        if cmd == "DELAY":
            ms = max(0, int(rest.strip() or "0"))
            print(f"  L{lineno:02d}: DELAY {ms}ms", flush=True)
            if not dry_run:
                time.sleep(ms / 1000.0)
            return
        if cmd in ("STRING", "STRINGLN"):
            preview = rest if len(rest) <= 28 else rest[:25] + "..."
            print(f"  L{lineno:02d}: {cmd} {preview!r}", flush=True)
            hid.type_string(rest)
            if cmd == "STRINGLN":
                hid.tap(0, SPECIAL_KEYS["ENTER"])
        else:
            tokens = stripped.split()
            combo = parse_combo(tokens)
            if combo is None:
                print(f"  L{lineno:02d}: [WARN] Unknown command: {stripped}", flush=True)
                return
            print(f"  L{lineno:02d}: KEY {'+'.join(tokens)}", flush=True)
            hid.tap(combo[0], combo[1])

        if default_delay_ms > 0 and not dry_run:
            time.sleep(default_delay_ms / 1000.0)

    print(f"[*] Executing BadUSB payload: {script_path.name}", flush=True)
    try:
        for idx, line in enumerate(lines, start=1):
            s = line.strip()
            if s.upper().startswith("REPEAT ") and prev_action:
                count = max(1, int(s.split()[1]))
                for _ in range(count):
                    exec_line(prev_action, idx)
            else:
                exec_line(line, idx)
                if s and not s.upper().startswith(("REM", "DELAY", "DEFAULT", "#")):
                    prev_action = line
    finally:
        hid.close()
    print(f"[+] Payload {script_path.name} finished.", flush=True)
    return 0


def scan_dir(dirs: list[Path], suffixes: tuple[str, ...]) -> list[Path]:
    found: list[Path] = []
    seen: set[str] = set()
    for d in dirs:
        if not d.is_dir():
            continue
        for p in sorted(d.iterdir()):
            if p.is_file() and p.suffix.lower() in suffixes and p.name not in seen:
                found.append(p)
                seen.add(p.name)
    return found


def interactive_menu() -> int:
    while True:
        os.system("clear")
        payloads = scan_dir(PAYLOAD_DIRS, (".duck", ".txt"))
        isos = scan_dir(ISO_DIRS, (".iso", ".img"))
        print("=== KALI CYBERDECK USB ARSENAL ===")
        print("1) Fire BadUSB Payload (.duck)")
        print("2) Mount Boot ISO / Loot IMG")
        print("3) Create 64MB FAT32 Loot IMG")
        print("4) Switch Mode: MTP (/home/kali)")
        print("5) Switch Mode: Combo (Net+HID)")
        print("6) Disable USB Gadget (Host)")
        print("q) Quit")
        choice = input("Select [1-6/q]: ").strip().lower()
        if choice in ("q", "exit", ""):
            return 0
        if choice == "1":
            if not payloads:
                print("No .duck payloads in /home/kali/payloads")
            else:
                for i, p in enumerate(payloads, 1):
                    print(f"  {i}) {p.name}")
                sel = input("Payload #: ").strip()
                if sel.isdigit() and 1 <= int(sel) <= len(payloads):
                    try:
                        run_ducky(payloads[int(sel) - 1])
                    except Exception as exc:
                        print(f"[ERR] {exc}")
            input("Press Enter...")
        elif choice == "2":
            if not isos:
                print("No .iso/.img in /home/kali/isos (choose 3 to create loot.img)")
            else:
                for i, p in enumerate(isos, 1):
                    mb = p.stat().st_size // (1024 * 1024)
                    print(f"  {i}) {p.name} ({mb}MB)")
                sel = input("Image #: ").strip()
                if sel.isdigit() and 1 <= int(sel) <= len(isos):
                    img = isos[int(sel) - 1]
                    mode = "loot" if "loot" in img.name.lower() else "iso"
                    subprocess.run(sudo_cmd([GADGET_CTL, mode, str(img)]), check=False)
            input("Press Enter...")
        elif choice == "3":
            subprocess.run(sudo_cmd([GADGET_CTL, "create-loot", "64"]), check=False)
            input("Press Enter...")
        elif choice == "4":
            subprocess.run(sudo_cmd([GADGET_CTL, "mtp"]), check=False)
            input("Press Enter...")
        elif choice == "5":
            subprocess.run(sudo_cmd([GADGET_CTL, "combo"]), check=False)
            input("Press Enter...")
        elif choice == "6":
            subprocess.run(sudo_cmd([GADGET_CTL, "off"]), check=False)
            input("Press Enter...")


def main() -> int:
    args = sys.argv[1:]
    if not args or args[0] in ("-h", "--help"):
        print("Usage: cz-badusb [--dry-run] <payload.duck> | --menu")
        return 0
    if args[0] == "--menu":
        return interactive_menu()
    dry = False
    if "--dry-run" in args:
        dry = True
        args = [a for a in args if a != "--dry-run"]
    if not args:
        print("ERROR: Missing payload file path", file=sys.stderr)
        return 1
    target = Path(args[0])
    if not target.is_file():
        for d in PAYLOAD_DIRS:
            cand = d / args[0]
            if cand.is_file():
                target = cand
                break
    if not target.is_file():
        print(f"ERROR: Payload not found: {args[0]}", file=sys.stderr)
        return 1
    return run_ducky(target, dry_run=dry)


if __name__ == "__main__":
    sys.exit(main())
