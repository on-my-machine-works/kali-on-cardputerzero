#!/usr/bin/env bash
# cz-ui-mode — Switch M5Stack CardputerZero primary 320x170 LCD shell between:
#   czctl     — Kali Cyberdeck Shell + :8899 Web KVM (default; alias: flipctl)
#   applaunch — Official M5Stack APPLaunch carousel (includes Kali Deck card)
#   status    — Show active LCD owner and :8899 Web KVM endpoint

set -euo pipefail

require_root() {
    if [[ $EUID -ne 0 ]]; then
        exec sudo "$0" "$@"
    fi
}

user_systemctl() {
    if id kali >/dev/null 2>&1; then
        local uid
        uid="$(id -u kali)"
        runuser -u kali -- env XDG_RUNTIME_DIR="/run/user/$uid" systemctl --user "$@" 2>/dev/null || true
    fi
}

cmd="${1:-status}"
case "$cmd" in
    czctl|flipctl)
        require_root "$@"
        systemctl stop fb_load.service 2>/dev/null || true
        user_systemctl stop APPLaunch.service
        user_systemctl disable APPLaunch.service
        rm -f /home/kali/.config/systemd/user/default.target.wants/APPLaunch.service
        if systemctl is-active --quiet czctl.service 2>/dev/null && pgrep -f M5CardputerZero-APPLaunch >/dev/null 2>&1; then
            # If APPLaunch was launched as a foreground child from czctl, exiting it returns cleanly to czctl
            pkill -f M5CardputerZero-APPLaunch 2>/dev/null || true
        else
            pkill -f M5CardputerZero-APPLaunch 2>/dev/null || true
            if [[ -f /etc/systemd/system/flipctl.service && ! -L /etc/systemd/system/flipctl.service ]]; then
                systemctl disable --now flipctl.service 2>/dev/null || true
                rm -f /etc/systemd/system/flipctl.service
            fi
            ln -sfn /etc/systemd/system/czctl.service /etc/systemd/system/flipctl.service
            systemctl daemon-reload
            systemctl enable --now czctl.service
        fi
        echo "Primary LCD UI set to: czctl (Kali Cyberdeck Shell + http://$(hostname -I | awk '{print $1}'):8899/)"
        ;;
    applaunch)
        require_root "$@"
        systemctl disable --now czctl.service 2>/dev/null || true
        systemctl disable --now flipctl.service 2>/dev/null || true
        if [[ -f /usr/lib/systemd/user/APPLaunch.service ]] && id kali >/dev/null 2>&1; then
            install -d -m 755 -o kali -g kali /home/kali/.config/systemd/user/default.target.wants
            ln -sfn /usr/lib/systemd/user/APPLaunch.service \
                /home/kali/.config/systemd/user/default.target.wants/APPLaunch.service
            chown -h kali:kali /home/kali/.config/systemd/user/default.target.wants/APPLaunch.service
            user_systemctl daemon-reload
            user_systemctl start APPLaunch.service
        fi
        echo "Primary LCD UI set to: M5 APPLaunch"
        ;;
    status)
        echo "czctl.service     : $(systemctl is-active czctl.service 2>/dev/null || true) ($(systemctl is-enabled czctl.service 2>/dev/null || true))"
        if id kali >/dev/null 2>&1; then
            uid="$(id -u kali)"
            app_st="$(runuser -u kali -- env XDG_RUNTIME_DIR="/run/user/$uid" systemctl --user is-active APPLaunch.service 2>/dev/null || true)"
            echo "APPLaunch.service : ${app_st:-inactive}"
        fi
        echo "LCD DRM node      : $(ls -l /dev/dri/cardputer-zero-internal 2>/dev/null || echo missing)"
        echo "LCD fbdev node    : $(ls -l /dev/fb_lcd 2>/dev/null || echo missing)"
        ip4="$(hostname -I 2>/dev/null | awk '{print $1}')"
        [[ -n "$ip4" ]] && echo "Web KVM (:8899)   : http://${ip4}:8899/"
        ;;
    *)
        echo "Usage: $0 {czctl|flipctl|applaunch|status}" >&2
        exit 1
        ;;
esac
