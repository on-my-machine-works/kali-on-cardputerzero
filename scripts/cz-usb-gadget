#!/usr/bin/env bash
# cz-usb-gadget — Switchable USB-C OTG Gadget CLI for M5Stack CardputerZero
# Delegates to the unified composite OTG manager (`cz-flipper-gadget`), supporting:
#   status | net | router-lan | hid | combo | mtp | iso <file> | loot <file> | create-loot [mb] | off

set -euo pipefail

SELF_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if [[ -x "$SELF_DIR/cz-flipper-gadget" ]]; then
    exec "$SELF_DIR/cz-flipper-gadget" "$@"
elif [[ -x /usr/local/bin/cz-flipper-gadget ]]; then
    exec /usr/local/bin/cz-flipper-gadget "$@"
fi

echo "ERROR: cz-flipper-gadget not found alongside $0 or at /usr/local/bin/cz-flipper-gadget" >&2
exit 1
