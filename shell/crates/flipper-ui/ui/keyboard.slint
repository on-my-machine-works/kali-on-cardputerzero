// Physical-keyboard text-input screen for M5Stack CardputerZero (320x170).
//
// CardputerZero has a built-in 46-key I2C matrix keyboard, so text entry prompts
// (Wi-Fi passphrases, boot profile renames, and hosted app text prompts) display a
// clean centred input card with live caret windowing and Esc/Bksp/Enter hints
// instead of an on-screen virtual keyboard or conflicting 4..8 softkey tabs.
import { FlipperTheme } from "@theme";
import { SelectorFrame, SoftBar } from "frame.slint";
import { StatusBar, PanelStatus } from "statusbar.slint";

// Retained for Slint interface compatibility across callers.
export struct KbCell {
    x: length,
    y: length,
    w: length,
    text: string,
    icon: int,
    icon_w: length,
    icon_h: length,
    selected: bool,
    pressed: bool,
    clip_h: length,
}

export component TextInputBody inherits Rectangle {
    in property <int> battery: PanelStatus.battery;
    in property <bool> charging: PanelStatus.charging;
    in property <bool> wifi_connected: PanelStatus.wifi_connected;
    in property <int> wifi_quality: PanelStatus.wifi_quality;
    in property <int> ethernet: PanelStatus.ethernet;
    in property <bool> recording: PanelStatus.recording;
    in property <bool> modem_available: PanelStatus.modem_available;
    in property <string> access_tech: PanelStatus.access_tech;
    in property <int> modem_quality: PanelStatus.modem_quality;

    in property <string> title;
    // Already windowed and marked by keyboard.rs, so what arrives here is what
    // fits.
    in property <string> visible_text;
    in property <length> field_w;
    in property <length> cursor_dx;
    in property <bool> cursor_on;
    in property <bool> field_focused;
    // False for a keyboard that types into something else, which has no field.
    in property <bool> field_shown: true;
    // Non-empty refuses the commit and shows why.
    in property <string> warning;
    // The rest of a warning too long for one line.
    in property <string> warning2;

    in property <[KbCell]> cells;
    in property <length> chrome_x;
    in property <length> chrome_y;
    in property <length> chrome_w;
    in property <length> chrome_h;
    in property <string> lang_label;
    in property <string> tab_label;
    // 0 none, 1 the 123 tab, 2 the backspace tab.
    in property <int> tab_focus;
    in property <int> tab_pressed;
    in property <[string]> buttons;
    in property <int> pressed_slot: -1;
    // Open with its highlighted row: 0 keeps the text, 1 throws it away.
    in property <int> discard: -1;

    width: 100%;
    height: 100%;
    background: FlipperTheme.white;

    property <length> field_x: Math.round((root.width - root.field_w) / 2 / 1px) * 1px;
    // A second warning line has no room above the keyboard, so the rest moves up.
    property <length> title_y:
        FlipperTheme.kb_title_y - (root.warning2 != "" ? FlipperTheme.kb_warning_lift : 0);
    property <length> field_y: root.title_y + FlipperTheme.kb_input_gap;
    property <length> warning_y: root.field_y + FlipperTheme.kb_input_h + FlipperTheme.kb_warning_gap;
    property <length> container_x:
        Math.floor((root.width - FlipperTheme.kb_container_w) / 2 / 1px) * 1px;
    property <length> tab_y:
        root.height - FlipperTheme.kb_tab_gap_b - FlipperTheme.kb_tab_h;
    property <length> tab2_x:
        root.width - FlipperTheme.kb_tab_inset - FlipperTheme.kb_tab_w;

    StatusBar {
        x: 0;
        y: 0;
        battery: root.battery;
        charging: root.charging;
        wifi_connected: root.wifi_connected;
        wifi_quality: root.wifi_quality;
        ethernet: root.ethernet;
        recording: root.recording;
        modem_available: root.modem_available;
        access_tech: root.access_tech;
        modem_quality: root.modem_quality;
    }

    // Physical-keyboard text-input card (shown for all field prompts on CardputerZero:
    // Wi-Fi passphrases, boot profile renames, and hosted app text prompts).
    // No on-screen virtual keyboard or conflicting 4..8 softkey tabs are drawn.
    if root.field_shown: SelectorFrame {
        x: FlipperTheme.kb_card_x;
        y: FlipperTheme.kb_card_y;
        frame_w: FlipperTheme.kb_card_w;
        frame_h: FlipperTheme.kb_card_h;
        radius: FlipperTheme.box;
        shadow: false;
        filled: true;
        fill_color: FlipperTheme.disabled_bg;
        stroke: true;
        stroke_color: FlipperTheme.divider;
    }

    if root.title != "": Text {
        x: Math.round((root.width - (self.width - 1px)) / 2 / 1px) * 1px;
        y: root.title_y;
        text: root.title;
        font-size: 16px;
        color: FlipperTheme.black;
    }

    // The field, sized to its text by the caller and centred inside the card.
    if root.field_shown: SelectorFrame {
        x: root.field_x;
        y: root.field_y;
        frame_w: root.field_w;
        frame_h: FlipperTheme.kb_input_h;
        radius: FlipperTheme.menu;
        shadow: false;
        filled: true;
        fill_color: FlipperTheme.white;
        stroke: true;
        stroke_color: FlipperTheme.divider;
    }
    if root.field_shown && root.field_focused: SelectorFrame {
        x: root.field_x - 1px;
        y: root.field_y - 1px;
        frame_w: root.field_w + 2px;
        frame_h: FlipperTheme.kb_input_h + 2px;
        radius: FlipperTheme.box;
        shadow: false;
        filled: false;
        stroke: true;
    }
    if root.field_shown && root.field_focused: SelectorFrame {
        x: root.field_x;
        y: root.field_y;
        frame_w: root.field_w;
        frame_h: FlipperTheme.kb_input_h;
        radius: FlipperTheme.menu;
        shadow: false;
        filled: false;
        stroke: true;
    }

    if root.field_shown: Text {
        x: root.field_x + FlipperTheme.kb_input_pad;
        y: root.field_y
            + Math.floor((FlipperTheme.kb_input_h - FlipperTheme.kb_text_ink_h) / 2 / 1px) * 1px;
        text: root.visible_text;
        font-size: 16px;
        color: FlipperTheme.black;
    }
    if root.field_shown && root.cursor_on: Rectangle {
        x: root.field_x + FlipperTheme.kb_input_pad + root.cursor_dx;
        y: root.field_y
            + Math.floor((FlipperTheme.kb_input_h - FlipperTheme.kb_text_ink_h) / 2 / 1px) * 1px;
        width: 1px;
        height: FlipperTheme.kb_text_ink_h;
        background: FlipperTheme.black;
    }

    if root.warning != "": Text {
        x: Math.round((root.width - (self.width - 1px)) / 2 / 1px) * 1px;
        y: root.warning_y;
        text: root.warning;
        font-size: 16px;
        color: FlipperTheme.black;
    }
    if root.warning2 != "": Text {
        x: Math.round((root.width - (self.width - 1px)) / 2 / 1px) * 1px;
        y: root.warning_y + FlipperTheme.kb_warning_line_h;
        text: root.warning2;
        font-size: 16px;
        color: FlipperTheme.black;
    }

    if root.field_shown && root.warning2 == "": Text {
        x: Math.round((root.width - (self.width - 1px)) / 2 / 1px) * 1px;
        y: FlipperTheme.kb_hint_y;
        text: "Type on keyboard  |  Sym: symbols";
        font-size: 16px;
        color: FlipperTheme.keycap_dim;
    }

    // Bottom physical-key legend (replaces softkey bar so keys 4 and 8 stay free for digits).
    if root.field_shown: Text {
        x: FlipperTheme.margin_h + 2px;
        y: FlipperTheme.kb_legend_y;
        text: "Esc: Cancel";
        font-size: 16px;
        color: FlipperTheme.status_dim;
    }
    if root.field_shown: Text {
        x: Math.floor((root.width - (self.width - 1px)) / 2 / 1px) * 1px;
        y: FlipperTheme.kb_legend_y;
        text: "Bksp: Del";
        font-size: 16px;
        color: FlipperTheme.status_dim;
    }
    if root.field_shown: Text {
        x: Math.floor((root.width - FlipperTheme.margin_h - 2px - self.width) / 1px) * 1px;
        y: FlipperTheme.kb_legend_y;
        text: "Enter: Confirm";
        font-size: 16px;
        color: root.warning == "" ? FlipperTheme.accent : FlipperTheme.disabled_fg;
    }

    // Legacy keys-only fallback (unused on CardputerZero; kept only if field_shown is false).
    if !root.field_shown: Rectangle {
        x: root.container_x;
        y: FlipperTheme.kb_container_y;
        width: FlipperTheme.kb_container_w;
        height: FlipperTheme.kb_container_h;
        background: FlipperTheme.white;
    }
    if !root.field_shown: Rectangle {
        x: root.chrome_x;
        y: root.chrome_y;
        width: root.chrome_w;
        height: root.chrome_h;
        background: FlipperTheme.white;
    }
    if !root.field_shown: SoftBar {
        buttons: root.buttons;
        pressed_slot: root.pressed_slot;
        disabled_slot: root.warning != "" ? 4 : -1;
    }

    // Leaving with unsaved text asks first, over a wash of everything else.
    if root.discard >= 0: Rectangle {
        width: 100%;
        height: 100%;
        background: FlipperTheme.white.with-alpha(FlipperTheme.overlay_alpha);

        property <length> mw: 150px;
        property <length> mh: 70px;
        property <length> mx: Math.floor((root.width - self.mw) / 2 / 1px) * 1px;
        property <length> my: Math.floor((root.height - self.mh) / 2 / 1px) * 1px;

        SelectorFrame {
            x: parent.mx;
            y: parent.my;
            frame_w: parent.mw;
            frame_h: parent.mh;
            radius: FlipperTheme.box;
            shadow: false;
            filled: true;
            fill_color: FlipperTheme.white;
            stroke: true;
        }
        Text {
            x: parent.mx + Math.floor((parent.mw - (self.width - 1px)) / 2 / 1px) * 1px;
            y: parent.my + 6px;
            text: "Discard changes?";
            font-size: 16px;
            font-family: "Born2bSportyV2";
            color: FlipperTheme.black;
        }
        Text {
            x: parent.mx + Math.floor((parent.mw - (self.width - 1px)) / 2 / 1px) * 1px;
            y: parent.my + 23px;
            text: "Your text won't be saved.";
            font-size: 16px;
            color: FlipperTheme.dialog_body;
        }
        for row[i] in ["Keep", "Discard"]: Rectangle {
            background: transparent;
            property <length> bw: parent.mw - 16px;
            property <length> bx: parent.mx + Math.floor((parent.mw - self.bw) / 2 / 1px) * 1px;
            property <length> by: parent.my + (i == 0 ? 36px : 52px);

            Text {
                x: parent.bx + Math.floor((parent.bw - (self.width - 1px)) / 2 / 1px) * 1px;
                y: parent.by
                    + Math.floor((FlipperTheme.button_h - FlipperTheme.kb_text_ink_h) / 2 / 1px) * 1px;
                text: row;
                font-size: 16px;
                color: FlipperTheme.black;
            }
            if i == root.discard: SelectorFrame {
                x: parent.bx;
                y: parent.by;
                frame_w: parent.bw;
                frame_h: FlipperTheme.button_h;
                filled: false;
                stroke: true;
            }
        }
    }
}
