// USB & Bluetooth HID Deck for M5Stack CardputerZero (320x170).
//
// Uses CardputerZero's built-in 46-key physical keyboard directly to send USB-C
// or Bluetooth LE HID keyboard, mouse, and media reports to a host computer,
// without an on-screen virtual keyboard.
import { Shell, PanelStatus } from "@app/shell.slint";
import { SelectorFrame } from "@flipctl/frame.slint";
import { StatusBar } from "@flipctl/statusbar.slint";
import { FlipperTheme } from "@theme";

export { PanelStatus }

export component AppWindow inherits Shell {
    in property <bool> to_host;
    in property <string> link;
    in property <string> state;
    in property <string> last_sent;
    in property <string> switch_hint;

    callback keyed(string, bool);
    key(text, down) => {
        root.keyed(text, down);
    }

    Rectangle {
        width: 100%;
        height: 100%;
        background: FlipperTheme.white;
    }

    StatusBar {
        x: 0;
        y: 0;
        battery: PanelStatus.battery;
        charging: PanelStatus.charging;
        wifi_connected: PanelStatus.wifi_connected;
        wifi_quality: PanelStatus.wifi_quality;
        ethernet: PanelStatus.ethernet;
        recording: PanelStatus.recording;
        modem_available: PanelStatus.modem_available;
        access_tech: PanelStatus.access_tech;
        modem_quality: PanelStatus.modem_quality;
    }

    // Top CardputerZero -> Host link badge row (clean Kali Dark frames, no Flipper sprites).
    SelectorFrame {
        x: 8px;
        y: 20px;
        frame_w: 118px;
        frame_h: 34px;
        radius: FlipperTheme.box;
        shadow: false;
        filled: true;
        fill_color: FlipperTheme.disabled_bg;
        stroke: true;
        stroke_color: FlipperTheme.divider;
    }
    Text {
        x: 8px + Math.round((118px - (self.width - 1px)) / 2 / 1px) * 1px;
        y: 24px;
        text: "CARDPUTER";
        font-size: 16px;
        color: FlipperTheme.black;
    }
    Text {
        x: 8px + Math.round((118px - (self.width - 1px)) / 2 / 1px) * 1px;
        y: 37px;
        text: root.to_host ? "Mouse + Media" : "46-Key QWERTY";
        font-size: 16px;
        color: FlipperTheme.keycap_dim;
    }

    Text {
        x: Math.floor((root.width - (self.width - 1px)) / 2 / 1px) * 1px;
        y: 31px;
        text: "--->";
        font-size: 16px;
        color: FlipperTheme.accent;
    }

    SelectorFrame {
        x: root.width - 126px;
        y: 20px;
        frame_w: 118px;
        frame_h: 34px;
        radius: FlipperTheme.box;
        shadow: false;
        filled: true;
        fill_color: FlipperTheme.disabled_bg;
        stroke: true;
        stroke_color: FlipperTheme.accent;
    }
    Text {
        x: (root.width - 126px) + Math.round((118px - (self.width - 1px)) / 2 / 1px) * 1px;
        y: 24px;
        text: root.link;
        font-size: 16px;
        color: FlipperTheme.accent;
    }
    Text {
        x: (root.width - 126px) + Math.round((118px - (self.width - 1px)) / 2 / 1px) * 1px;
        y: 37px;
        text: root.state;
        font-size: 16px;
        color: FlipperTheme.black;
    }

    // Live physical-keyboard / mouse HID status card.
    SelectorFrame {
        x: 8px;
        y: 62px;
        frame_w: root.width - 16px;
        frame_h: 78px;
        radius: FlipperTheme.box;
        shadow: false;
        filled: true;
        fill_color: FlipperTheme.disabled_bg;
        stroke: true;
        stroke_color: FlipperTheme.divider;
    }

    Text {
        x: Math.round((root.width - (self.width - 1px)) / 2 / 1px) * 1px;
        y: 70px;
        text: root.to_host ? "Mode: MOUSE + MEDIA" : "Mode: PHYSICAL QWERTY -> HOST";
        font-size: 16px;
        color: FlipperTheme.accent;
    }

    SelectorFrame {
        x: 22px;
        y: 88px;
        frame_w: root.width - 44px;
        frame_h: 20px;
        radius: FlipperTheme.menu;
        shadow: false;
        filled: true;
        fill_color: FlipperTheme.white;
        stroke: true;
        stroke_color: FlipperTheme.divider;
    }

    Text {
        x: Math.round((root.width - (self.width - 1px)) / 2 / 1px) * 1px;
        y: 92px;
        text: root.last_sent;
        font-size: 16px;
        color: FlipperTheme.black;
    }

    Text {
        x: Math.round((root.width - (self.width - 1px)) / 2 / 1px) * 1px;
        y: 118px;
        text: root.to_host
            ? "Arrows: Move   Enter/Bksp: Click   7/5: Vol"
            : "Type directly (all 46 keys, Shift, Sym, Ctrl)";
        font-size: 16px;
        color: FlipperTheme.keycap_dim;
    }

    // Bottom physical-key legend (keeps digits 4..8 free for live typing).
    Text {
        x: 10px;
        y: 148px;
        text: "Esc: Close";
        font-size: 16px;
        color: FlipperTheme.status_dim;
    }
    Text {
        x: Math.floor((root.width - (self.width - 1px)) / 2 / 1px) * 1px;
        y: 148px;
        text: "Fn+6: Mode";
        font-size: 16px;
        color: FlipperTheme.status_dim;
    }
    Text {
        x: Math.floor((root.width - 10px - self.width) / 1px) * 1px;
        y: 148px;
        text: root.switch_hint;
        font-size: 16px;
        color: FlipperTheme.accent;
    }
}
